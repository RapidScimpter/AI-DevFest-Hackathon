# Copy to .env and edit. Every value has a safe local default.
SUROKKHA_ENVIRONMENT=development          # set to production for a real deployment
SUROKKHA_SECRET_KEY=replace-with-a-long-random-string
SUROKKHA_DATABASE_URL=sqlite:///data/surokkha.sqlite3   # or postgresql+psycopg://user:pass@host/db
SUROKKHA_COOKIE_SECURE=false              # true when served over HTTPS
SUROKKHA_DEMO_MODE=true                   # false hides presenter controls and ignores simulated signals
SUROKKHA_REVIEW_THRESHOLD=0.30
SUROKKHA_HIGH_THRESHOLD=0.70
